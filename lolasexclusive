-- RGB Sliders
local currentColor = Color3.new(1, 1, 1)

local function createSlider(labelText, gradientColors)
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(1, 0, 0, 30)
    sliderFrame.BackgroundColor3 = Color3.new(0.3, 0.3, 0.3)
    sliderFrame.Parent = colorFontFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 30, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Parent = sliderFrame

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -40, 0.5, 0)
    bar.Position = UDim2.new(0, 40, 0.25, 0)
    bar.Parent = sliderFrame

    local uiGradient = Instance.new("UIGradient")
    uiGradient.Color = ColorSequence.new(gradientColors[1], gradientColors[2])
    uiGradient.Parent = bar

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 10, 1, 0)
    knob.Position = UDim2.new(1, -5, 0, 0)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.Text = ""
    knob.Parent = bar

    local uis = game:GetService("UserInputService")
    local dragging = false

    knob.MouseButton1Down:Connect(function()
        dragging = true
    end)

    uis.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    uis.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local relativeX = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            knob.Position = UDim2.new(relativeX, -5, 0, 0)
            return relativeX
        end
    end)

    return sliderFrame, function()
        return (knob.Position.X.Scale + 0.5 / bar.Size.X.Scale)  -- approximate
    end
end

